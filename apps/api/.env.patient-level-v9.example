# patient-level-stratified-management-v9
# Enable only after the v9 migration, Prisma generate, and clinical-rule seed
# have completed successfully.
CARE_PLAN_REFRESH_WORKER_ENABLED=false
CARE_PLAN_REFRESH_WORKER_INTERVAL_MS=300000
CARE_PLAN_REFRESH_WORKER_HEARTBEAT_INTERVAL_MS=20000
CARE_PLAN_REFRESH_WORKER_HEARTBEAT_STALE_AFTER_MS=90000
CARE_PLAN_REFRESH_WORKER_LOCK_HOLD_TIMEOUT_MS=900000
# Hard-coded vital/questionnaire thresholds remain available only as an
# explicit local-development fallback. Keep false for governed pilot use.
CLINICAL_RULE_ALLOW_LEGACY_FALLBACK=false
PATIENT_SUBMISSION_REVIEW_SLA_HOURS=24

# pilot-security-integrity-v9.3
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://d415-52-124-41-233.ngrok-free.app
TRUSTED_PROXY_CIDRS=
AUTH_THROTTLE_SECRET=change_me_independent_of_jwt
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_LOCK_MS=900000
AUTH_LOGIN_MAX_FAILURES_ADMIN=3
AUTH_LOGIN_MAX_FAILURES_USERNAME=5
AUTH_LOGIN_MAX_FAILURES_IP=20

# WeChat official-account local/demo sync.
# On API startup, these values are synced into HospitalWechatOfficialAccount
# for LOCAL_HOSPITAL_TENANT_ID so nurse-side sends use the latest template IDs.
LOCAL_HOSPITAL_TENANT_ID=demo-tenant-001
PATIENT_ENGAGEMENT_BASE_URL=https://your-5173-public-domain.example.com
PATIENT_ENGAGEMENT_API_BASE_URL=https://your-3000-public-domain.example.com
WECHAT_OFFICIAL_ACCOUNT_ENV_SYNC=true
WECHAT_OFFICIAL_ACCOUNT_ENABLED=true
WECHAT_OFFICIAL_ACCOUNT_APP_ID=wx_your_test_or_service_account_appid
WECHAT_OFFICIAL_ACCOUNT_APP_SECRET=your_app_secret
WECHAT_OFFICIAL_ACCOUNT_OAUTH_SCOPE=snsapi_userinfo
WECHAT_OFFICIAL_ACCOUNT_TEMPLATE_QUESTIONNAIRE=
WECHAT_OFFICIAL_ACCOUNT_TEMPLATE_VITAL=
WECHAT_OFFICIAL_ACCOUNT_TEMPLATE_MEDICATION=
WECHAT_OFFICIAL_ACCOUNT_TEMPLATE_HOSPITAL_VISIT=
