generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum DiseaseType {
  HYPERTENSION
  TYPE_2_DIABETES
  COPD
  CORONARY_HEART_DISEASE
  HYPERLIPIDEMIA
  OBESITY
  OTHER
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum DataSource {
  HIS
  EMR
  LIS
  MINI_PROGRAM
  NURSE_INPUT
  MANUAL_IMPORT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELED
}

enum AlertStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum RiskEpisodeStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum ClinicalRuleLifecycleStatus {
  DRAFT
  PHYSICIAN_REVIEW
  PUBLISHED
  EFFECTIVE
  DEACTIVATED
}


enum UserRole {
  ADMIN
  DOCTOR
  NURSE
  MANAGER
}


enum PatientBindingStatus {
  PENDING
  APPROVED
  REJECTED
}


enum HospitalVisitReminderStatus {
  ACTIVE
  ARRIVED
  NO_SHOW
  REFUSED
  REVOKED
}

enum EncounterType {
  OUTPATIENT
  INPATIENT
  EMERGENCY
  CHECKUP
}

enum MedicalRecordType {
  OUTPATIENT_NOTE
  INPATIENT_RECORD
  DISCHARGE_SUMMARY
  PROGRESS_NOTE
  CONSULTATION_NOTE
}


enum IntegrationSystemType {
  HIS
  EMR
  LIS
  PHARMACY
  CHECKUP
  MESSAGE
  OTHER
}

enum IntegrationSyncStatus {
  PENDING
  RUNNING
  SUCCESS
  PARTIAL_FAILED
  FAILED
}

enum IntegrationRecordStatus {
  SUCCESS
  FAILED
  SKIPPED
}

// IntegrationPromotionStatus — gateway-promote-pipeline
//
// 审计层 (IntegrationRecordStatus) 表示「外部数据是否成功被网关接收」，
// 这里则表示「已接收的审计记录是否已 promote 到 Patient / VitalRecord /
// DiseaseProfile / EncounterRecord / MedicalRecordSummary /
// HospitalMedicationOrder 等正式业务表」。
//
//   NOT_REQUIRED — 不需要 promote（例如 IntegrationsService 旧的 mock-sync
//                  在写审计之前就直接落了业务表；或 SKIPPED 重复事件）
//   PENDING      — 已审计、待人工/批量 promote
//   PROMOTED     — 已成功落到业务表（localTargetType / localTargetId 同时填充）
//   CONFLICT     — promote 命中冲突，需要人工核验（例如同院内号、不同身份证）
//   FAILED       — promote 抛错（patient 不存在、字段缺失等），可重试
enum IntegrationPromotionStatus {
  NOT_REQUIRED
  PENDING
  PROMOTED
  CONFLICT
  FAILED
}

enum ExternalRecordStatus {
  STAGED
  IMPORTED
  FAILED
}

model Patient {
  id              String   @id @default(uuid())
  hospitalPatientId String? @unique
  name            String
  gender          Gender   @default(UNKNOWN)
  birthDate       DateTime?
  phone           String?
  idCardNo        String?
  address         String?
  emergencyContactName  String?
  emergencyContactPhone String?

  responsibleDoctorId String?
  responsibleNurseId  String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  responsibleDoctor   User? @relation("PatientDoctor", fields: [responsibleDoctorId], references: [id])
  responsibleNurse    User? @relation("PatientNurse", fields: [responsibleNurseId], references: [id])

  diseaseProfiles DiseaseProfile[]
  vitalRecords    VitalRecord[]
  followUps       FollowUpRecord[]
  tasks           Task[]
  taskProcessingEvents TaskProcessingEvent[]

  riskAlerts     RiskAlert[]
  riskEpisodes   RiskEpisode[]
  medicationRecords MedicationRecord[]
  medicationCheckIns MedicationCheckIn[]
  questionnaireResults QuestionnaireResult[]
  vitalMonitoringPlans VitalMonitoringPlan[]
  hospitalVisitReminders HospitalVisitReminder[]
  encounterRecords EncounterRecord[]
  medicalRecordSummaries MedicalRecordSummary[]
  examReportRecords ExamReportRecord[]
  hospitalMedicationOrders HospitalMedicationOrder[]

  promotedFromLeads        ChronicLead[]      @relation("LeadPromotedPatient")

  @@index([responsibleDoctorId])
  @@index([responsibleNurseId])
  @@index([createdAt])

  // patient-engagement-wechat-h5-v1
  hospitalTenantId String?
  hospitalTenant   HospitalTenant? @relation(fields: [hospitalTenantId], references: [id])
  wechatIdentities PatientWechatIdentity[]
  formLinks        PatientFormLink[]
  outboundMessages PatientOutboundMessage[]

  @@index([hospitalTenantId])
  // care-reminders v3
  careReminderSchedules   CareReminderSchedule[]
  careReminderOccurrences CareReminderOccurrence[]
  patientDirectMessages   PatientDirectMessage[]
  // patient_engagement_v3_2
  outboundAttempts        PatientOutboundAttempt[]
  hospitalVisitFeedbacks  HospitalVisitFeedback[]

  // patient-level-stratified-management-v9
  carePlans              CarePlan[]
  riskStratifications    PatientRiskStratification[]
  nextBestActions        NextBestAction[]
}

model DiseaseProfile {
  id             String      @id @default(uuid())
  patientId      String
  diseaseType    DiseaseType
  diagnosisDate  DateTime?
  diseaseStage   String?
  complications  String?
  comorbidities  String?
  riskLevel      RiskLevel   @default(LOW)
  dataSource     DataSource  @default(NURSE_INPUT)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient        Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([diseaseType])
  @@index([riskLevel])
  @@index([patientId, riskLevel])
}

model VitalRecord {
  id          String     @id @default(uuid())
  patientId   String
  type        String
  value       Float
  unit        String
  measuredAt  DateTime
  dataSource  DataSource @default(MINI_PROGRAM)
  isAbnormal  Boolean    @default(false)
  note        String?
  monitoringPlanId String?
  scheduledAt DateTime?

  createdAt   DateTime @default(now())

  patient     Patient @relation(fields: [patientId], references: [id])
  monitoringPlan VitalMonitoringPlan? @relation(fields: [monitoringPlanId], references: [id])

  @@index([patientId, measuredAt])
  @@index([patientId, type, measuredAt])
  @@index([monitoringPlanId, measuredAt])
  @@index([isAbnormal, measuredAt])
}

model FollowUpRecord {
  id              String   @id @default(uuid())
  patientId        String
  followUpType     String
  followUpTime     DateTime
  content          String?
  result           String?
  suggestion       String?
  nextFollowUpTime DateTime?
  operatorId       String?

  createdAt        DateTime @default(now())

  patient          Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, followUpTime])
  @@index([operatorId, followUpTime])
}

model Task {
  id          String     @id @default(uuid())
  patientId   String
  title       String
  type        String
  status      TaskStatus @default(PENDING)
  dueAt       DateTime?
  assigneeId  String?
  relatedAlertId String?
  riskEpisodeId String?
  // Database-level concurrency guard: exactly one open disposition task may
  // hold an episode token. Closing clears it so history remains append-only.
  openRiskEpisodeKey String? @unique
  // Lower number = more urgent. 0=VERY_HIGH, 1=HIGH, 2=MEDIUM, 3=routine.
  priority    Int        @default(3)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient     Patient @relation(fields: [patientId], references: [id])
  processingEvents TaskProcessingEvent[]
  riskEpisode RiskEpisode? @relation("TaskRiskEpisode", fields: [riskEpisodeId], references: [id], onDelete: SetNull)
  referencedAsOpenByEpisodes RiskEpisode[] @relation("RiskEpisodeOpenTask")
  nextBestActions NextBestAction[]

  @@index([patientId, status, dueAt])
  @@index([assigneeId, status, dueAt])
  @@index([relatedAlertId])
  @@index([riskEpisodeId, status])
  @@index([priority, status, dueAt])
}

model TaskProcessingEvent {
  id                  String   @id @default(uuid())
  taskId              String
  patientId           String
  eventType           String
  title               String
  description         String?
  sourceType          String?
  sourceId            String?
  operatorId          String?
  electronicSignature String?
  createdAt           DateTime @default(now())

  task                Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  patient             Patient  @relation(fields: [patientId], references: [id])

  @@index([taskId, createdAt])
  @@index([patientId, createdAt])
  @@index([eventType, createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  operatorId  String?
  action      String
  targetType  String
  targetId    String?
  ipAddress   String?
  beforeData  Json?
  afterData   Json?
  createdAt   DateTime @default(now())

  @@index([operatorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
}

model RiskAlert {
  id                String      @id @default(uuid())
  patientId          String
  riskType           String
  riskLevel          RiskLevel   @default(MEDIUM)
  title              String
  description        String?
  triggerRule        String?

  // patient-level-stratified-management-v9: immutable evaluation evidence
  ruleId             String?
  ruleVersion        String?
  ruleSnapshot       Json?
  evidenceBasis      String?
  evaluatedAt        DateTime?
  inputSnapshot      Json?
  matchedConditions  Json?

  sourceVitalRecordId String?
  sourceQuestionnaireResultId String?
  riskEpisodeId      String?
  status             AlertStatus @default(OPEN)

  handledBy          String?
  handledAt          DateTime?
  handlingNote       String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  patient            Patient @relation(fields: [patientId], references: [id])
  riskEpisode        RiskEpisode? @relation(fields: [riskEpisodeId], references: [id], onDelete: SetNull)

  @@index([patientId, status, createdAt])
  @@index([status, riskLevel, createdAt])
  @@index([sourceVitalRecordId])
  @@index([sourceQuestionnaireResultId])
  @@index([riskEpisodeId, status])
}

model RiskEpisode {
  id               String            @id @default(uuid())
  patientId        String
  riskCategory     String
  correlationKey   String
  // Only OPEN / IN_PROGRESS episodes keep openKey. Closing clears it so a
  // future signal can start a new episode without colliding with history.
  openKey           String?           @unique
  firstTriggeredAt DateTime          @default(now())
  lastTriggeredAt  DateTime          @default(now())
  peakRiskLevel    RiskLevel
  status           RiskEpisodeStatus @default(OPEN)
  openTaskId       String?
  triggerCount     Int               @default(1)
  latestEvidence   Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  openTask         Task?             @relation("RiskEpisodeOpenTask", fields: [openTaskId], references: [id], onDelete: SetNull)
  alerts           RiskAlert[]
  tasks            Task[]            @relation("TaskRiskEpisode")

  @@index([patientId, status, lastTriggeredAt])
  @@index([riskCategory, status, lastTriggeredAt])
  @@index([correlationKey, status])
  @@index([openTaskId])
}

model VitalMonitoringPlan {
  id             String     @id @default(uuid())
  patientId      String
  vitalType      String
  displayName    String
  unit           String
  frequencyUnit  String     @default("DAY")
  timesPerUnit   Int        @default(1)
  customMeasureTimes Json?
  customMeasureDays Json?
  reminderLeadMinutes Int   @default(180)
  checkInWindowBeforeMinutes Int @default(180)
  missedWindowAfterMinutes Int @default(180)
  missedFollowUpDueWithinMinutes Int @default(1440)
  sourcePreset   String?
  evidenceBasis  String?
  evidenceSource String?
  isActive       Boolean    @default(true)
  lastCheckInAt  DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient        Patient @relation(fields: [patientId], references: [id])
  vitalRecords   VitalRecord[]

  @@index([patientId, isActive])
  @@index([patientId, vitalType])
}

model MedicationRecord {
  id             String     @id @default(uuid())
  patientId      String
  medicationName String
  dosage         String

  // Backward-compatible display text generated from structured schedule fields.
  frequency      String
  frequencyUnit  String     @default("DAY")
  timesPerUnit   Int        @default(1)
  timingRelation String     @default("NONE")
  customDoseTimes Json?
  customDoseDays Json?
  reminderLeadMinutes Int   @default(180)
  checkInWindowBeforeMinutes Int @default(180)
  missedWindowAfterMinutes Int @default(180)

  instructions   String?
  startDate      DateTime?
  endDate        DateTime?
  dataSource     DataSource @default(NURSE_INPUT)
  isActive       Boolean    @default(true)
  lastCheckInAt  DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient        Patient @relation(fields: [patientId], references: [id])
  checkIns       MedicationCheckIn[]

  @@index([patientId, isActive])
  @@index([patientId, medicationName])
}

model MedicationCheckIn {
  id           String   @id @default(uuid())
  medicationId String
  patientId    String
  taken        Boolean  @default(true)
  checkedAt    DateTime
  scheduledAt  DateTime?
  note         String?

  createdAt    DateTime @default(now())

  medication   MedicationRecord @relation(fields: [medicationId], references: [id])
  patient      Patient @relation(fields: [patientId], references: [id])

  @@index([medicationId, scheduledAt])
  @@index([patientId, checkedAt])
}

model QuestionnaireResult {
  id                String     @id @default(uuid())
  patientId          String
  questionnaireType  String
  // For H5 demo forms, retain the patient's original 0-9 UI score separately
  // from the score scaled into the governed questionnaire template range.
  rawScore           Int?
  score              Int
  riskLevel          RiskLevel  @default(LOW)
  riskConclusion     String
  answers            Json?
  note               String?
  dataSource         DataSource @default(MINI_PROGRAM)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  patient            Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, createdAt])
  @@index([patientId, riskLevel, createdAt])
}


model User {
  id           String   @id @default(uuid())
  username     String   @unique
  displayName  String
  role         UserRole
  passwordHash String
  isActive     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientsAsDoctor Patient[] @relation("PatientDoctor")
  patientsAsNurse  Patient[] @relation("PatientNurse")

  reviewedLeads    ChronicLead[] @relation("LeadReviewer")

  @@index([role, isActive])

  // patient-engagement-wechat-h5-v1
  hospitalTenantId String?
  hospitalTenant   HospitalTenant? @relation(fields: [hospitalTenantId], references: [id])

  @@index([hospitalTenantId])
  // care-reminders v3
  sentDirectMessages PatientDirectMessage[] @relation("UserSentDirectMessages")
}

model PatientBindingRequest {
  id                String               @id @default(uuid())
  demoOpenId        String
  patientId         String
  hospitalPatientId String?
  phone             String
  idCardLast4       String?
  status            PatientBindingStatus @default(PENDING)
  rejectReason      String?
  reviewedBy        String?
  reviewedAt        DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([demoOpenId, status, createdAt])
  @@index([patientId, status])
  @@index([status, createdAt])
}

model PatientSession {
  id          String   @id @default(uuid())
  demoOpenId  String
  patientId   String
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?

  createdAt   DateTime @default(now())

  @@index([demoOpenId, patientId])
  @@index([patientId, expiresAt])
  @@index([expiresAt])
}


// ============================================================================
// PatientConsent — 患者端统一知情同意书记录
//
// 设计要点（patient-self-consent-bind）:
//   不论患者来自邀约库 (ChronicLead)、已有 Patient 档案，还是 HIS 暂存患者信息，
//   只要患者在小程序绑定流程里勾选并签署《知情同意与隐私授权协议》，
//   就在这张表落一条独立、可追溯的同意书记录。
//
//   - 与 ChronicLead / Patient / PatientBindingRequest 为松耦合（仅存 id，不建外键），
//     因为同意书是在「提交绑定申请」之前先签的，签署时这些行可能还不存在。
//   - 一个 demoOpenId 对同一识别对象重复签署时，旧记录会被置为 SUPERSEDED，
//     始终只保留一条 SIGNED 的有效同意书。
// ============================================================================

enum PatientConsentSource {
  MINI_PROGRAM
  NURSE_PROXY
  DOCTOR_PROXY
}

enum PatientConsentStatus {
  SIGNED
  SUPERSEDED
  REVOKED
}

model PatientConsent {
  id                  String               @id @default(uuid())

  // ---- 患者端可信标识 ----
  demoOpenId          String
  hospitalPatientId   String?

  // ---- 松耦合关联（签署时可能尚不存在）----
  chronicLeadId       String?
  patientId           String?
  bindingRequestId    String?

  // ---- 同意书内容快照 ----
  consentVersion      String
  consentSource       PatientConsentSource @default(MINI_PROGRAM)
  consentTextSnapshot String?
  matchType           String?

  // ---- 签署证据 ----
  signedAt            DateTime             @default(now())
  ipAddress           String?
  userAgent           String?

  status              PatientConsentStatus @default(SIGNED)

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([demoOpenId, status, createdAt])
  @@index([chronicLeadId])
  @@index([patientId])
  @@index([bindingRequestId])
  @@index([hospitalPatientId])
}


model HospitalVisitReminder {
  id                String                      @id @default(uuid())
  patientId         String
  sourceRiskAlertId String?
  sourceTaskId      String?
  riskEpisodeId    String?
  reason            String
  note              String?
  status            HospitalVisitReminderStatus @default(ACTIVE)

  remindedBy        String?
  remindedAt        DateTime                    @default(now())
  followUpDueWithinHours Int                     @default(48)
  retryDueWithinHours    Int                     @default(24)

  revokedBy         String?
  revokedAt         DateTime?
  revokeReason      String?

  arrivedAt         DateTime?
  arrivalConfirmedBy String?

  noShowAt          DateTime?
  noShowConfirmedBy String?

  refusedAt         DateTime?
  refusalConfirmedBy String?

  outcomeNote       String?

  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  patient           Patient                     @relation(fields: [patientId], references: [id])

  @@index([patientId, status, remindedAt])
  @@index([status, remindedAt])
  @@index([sourceRiskAlertId])
  @@index([sourceTaskId])
  @@index([riskEpisodeId])
}

model DiseaseRuleTemplate {
  id              String      @id @default(uuid())
  diseaseType     DiseaseType
  templateName    String
  description     String?
  managementGoal  String?
  riskBasis       String?
  version         String      @default("v1")
  isActive        Boolean     @default(false)

  // patient-level-stratified-management-v9: release workflow
  lifecycleStatus ClinicalRuleLifecycleStatus @default(DRAFT)
  evidenceBasis   String?
  effectiveFrom   DateTime?
  effectiveUntil  DateTime?
  publishedAt     DateTime?
  publishedBy     String?
  deactivatedAt   DateTime?
  deactivatedBy   String?
  basedOnTemplateId String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  vitalThresholdRules VitalThresholdRule[]
  followUpPolicies    FollowUpPolicy[]
  questionnaireTemplates QuestionnaireTemplate[]
  approvals              ClinicalRuleApproval[]

  @@unique([diseaseType, version])
  @@index([diseaseType, isActive])
}

model VitalThresholdRule {
  id                String      @id @default(uuid())
  templateId         String
  vitalType          String
  displayName        String
  unit               String
  operator           String
  thresholdValue     Float
  thresholdValueMax  Float?
  riskLevel          RiskLevel
  alertTitle         String
  alertDescription   String?
  followUpAction     String?
  sortOrder          Int         @default(100)
  isActive           Boolean     @default(true)

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  template            DiseaseRuleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, isActive])
  @@index([vitalType, isActive])
  @@index([riskLevel, isActive])
}

model FollowUpPolicy {
  id                    String      @id @default(uuid())
  templateId             String
  riskLevel              RiskLevel
  followUpType           String
  dueWithinHours         Int
  frequencyDescription   String
  taskTitle              String
  instruction            String?
  isActive               Boolean     @default(true)

  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  template                DiseaseRuleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, riskLevel, isActive])
  @@index([riskLevel, isActive])
}

model QuestionnaireTemplate {
  id                  String      @id @default(uuid())
  templateId           String
  questionnaireType    String
  title                String
  description          String?
  scoringRule          Json?
  riskBands            Json?
  isActive             Boolean     @default(true)

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  template              DiseaseRuleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, isActive])
  @@index([questionnaireType, isActive])
}

// ============================================================================
// patient-level-stratified-management-v9
// ============================================================================

model ClinicalRuleApproval {
  id          String   @id @default(uuid())
  templateId  String
  reviewerId  String
  reviewerRole String
  decision    String   @default("APPROVED")
  note        String?
  createdAt   DateTime @default(now())

  template DiseaseRuleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, reviewerId])
  @@index([templateId, decision, createdAt])
}

model CarePlan {
  id                  String   @id @default(uuid())
  patientId           String
  // Only the active plan owns this token. Paused/completed history keeps null.
  activeKey           String?  @unique
  cohort              String   @default("THREE_HIGHS")
  stratificationLevel RiskLevel @default(LOW)
  goals               Json?
  activeInterventions Json?
  followUpCadence     Json?
  referralStatus      String   @default("NONE")
  nextReviewAt        DateTime?
  owningTeamId        String?
  version             Int      @default(1)
  status              String   @default("ACTIVE")
  enrolledAt          DateTime @default(now())
  pausedAt            DateTime?
  completedAt         DateTime?
  createdBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  patient              Patient                     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  riskStratifications  PatientRiskStratification[]
  nextBestActions      NextBestAction[]

  @@index([patientId, status])
  @@index([cohort, stratificationLevel, status])
  @@index([nextReviewAt, status])
}

model PatientRiskStratification {
  id            String    @id @default(uuid())
  carePlanId    String
  patientId     String
  riskLevel     RiskLevel
  priorityScore Int
  reasons       Json
  policyVersion String
  calculatedAt  DateTime  @default(now())

  carePlan CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, calculatedAt])
  @@index([carePlanId, calculatedAt])
  @@index([riskLevel, priorityScore, calculatedAt])
}

model NextBestAction {
  id             String   @id @default(uuid())
  carePlanId     String
  patientId      String
  actionType     String
  actionKey      String
  activeKey      String?  @unique
  title          String
  reasonSummary  String
  evidence       Json
  priorityScore  Int
  requiresDoctor Boolean  @default(false)
  status         String   @default("PROPOSED")
  dueAt          DateTime?
  linkedTaskId   String?
  acceptedBy     String?
  acceptedAt     DateTime?
  dismissedBy    String?
  dismissedAt    DateTime?
  dismissReason  String?
  expiresAt      DateTime?
  policyVersion  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  carePlan   CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  linkedTask Task?    @relation(fields: [linkedTaskId], references: [id], onDelete: SetNull)

  @@index([patientId, status, priorityScore])
  @@index([carePlanId, status])
  @@index([actionType, status, dueAt])
  @@index([linkedTaskId])
}

model IntegrationSource {
  id          String                @id @default(uuid())
  code        String                @unique
  name        String
  systemType  IntegrationSystemType
  baseUrl     String?
  description String?
  isEnabled   Boolean               @default(true)

  // gateway-promote-pipeline:
  // 是否在审计写入后由 InboundEventService 自动调用 IntegrationPromoteService。
  // 默认 false —— 数据先进审计层，由管理员在【接口中心】手动点 promote。
  // 把某个来源（例如医院已经稳定的 HL7 通道）切到 true 之后，新事件会同步
  // 尝试 promote；遇到冲突照样进入 CONFLICT 队列，不会污染主数据。
  autoPromote Boolean               @default(false)

  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  syncBatches  IntegrationSyncBatch[]
  syncRecords  IntegrationSyncRecord[]
  fieldMappings IntegrationFieldMapping[]
  apiKeys      GatewayApiKey[]

  @@index([systemType, isEnabled])
}

model IntegrationSyncBatch {
  id           String                 @id @default(uuid())
  sourceId     String
  batchType    String
  status       IntegrationSyncStatus  @default(PENDING)
  startedAt    DateTime               @default(now())
  finishedAt   DateTime?
  totalCount   Int                    @default(0)
  successCount Int                    @default(0)
  failedCount  Int                    @default(0)
  operatorId   String?
  message      String?

  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  source        IntegrationSource      @relation(fields: [sourceId], references: [id])
  records       IntegrationSyncRecord[]

  @@index([sourceId, status, startedAt])
  @@index([batchType, status, startedAt])
}

model IntegrationSyncRecord {
  id                 String                  @id @default(uuid())
  sourceId           String
  batchId            String
  externalRecordType String
  externalRecordId   String
  localTargetType    String?
  localTargetId      String?
  status             IntegrationRecordStatus
  errorMessage        String?
  rawData             Json?
  normalizedData      Json?

  // gateway-promote-pipeline:
  // 审计 (status) 与 promote (promotionStatus) 是两条独立的状态线。
  // promotionMessage 在 CONFLICT/FAILED 时给出人类可读的原因。
  // promotedAt 仅在 promotionStatus = PROMOTED 时填充，便于 SLA 统计。
  promotionStatus     IntegrationPromotionStatus @default(NOT_REQUIRED)
  promotionMessage    String?
  promotedAt          DateTime?

  // gateway-production-hardening: retry / backoff metadata
  // GatewayPromotionWorker uses these to re-promote FAILED records
  // with exponential backoff until promotionAttempts exhausts
  // the configured max, after which an alert is emitted.
  promotionAttempts   Int       @default(0)
  nextRetryAt         DateTime?
  lastFailedAt        DateTime?
  lastFailureReason   String?

  createdAt           DateTime                @default(now())

  source              IntegrationSource       @relation(fields: [sourceId], references: [id])
  batch               IntegrationSyncBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([sourceId, externalRecordType, externalRecordId])
  @@index([batchId, status])
  @@index([localTargetType, localTargetId])
  @@index([promotionStatus, createdAt])
  @@index([sourceId, promotionStatus])
  @@index([promotionStatus, nextRetryAt])
}

model IntegrationFieldMapping {
  id            String             @id @default(uuid())
  sourceId      String
  targetModel   String
  externalField String
