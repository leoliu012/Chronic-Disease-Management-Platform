generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum DiseaseType {
  HYPERTENSION
  TYPE_2_DIABETES
  COPD
  CORONARY_HEART_DISEASE
  HYPERLIPIDEMIA
  OBESITY
  OTHER
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum DataSource {
  HIS
  EMR
  LIS
  MINI_PROGRAM
  NURSE_INPUT
  MANUAL_IMPORT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELED
}

enum AlertStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}


enum UserRole {
  ADMIN
  DOCTOR
  NURSE
  MANAGER
}


enum PatientBindingStatus {
  PENDING
  APPROVED
  REJECTED
}


enum HospitalVisitReminderStatus {
  ACTIVE
  ARRIVED
  NO_SHOW
  REFUSED
  REVOKED
}

enum EncounterType {
  OUTPATIENT
  INPATIENT
  EMERGENCY
  CHECKUP
}

enum MedicalRecordType {
  OUTPATIENT_NOTE
  INPATIENT_RECORD
  DISCHARGE_SUMMARY
  PROGRESS_NOTE
  CONSULTATION_NOTE
}


enum IntegrationSystemType {
  HIS
  EMR
  LIS
  PHARMACY
  CHECKUP
  MESSAGE
  OTHER
}

enum IntegrationSyncStatus {
  PENDING
  RUNNING
  SUCCESS
  PARTIAL_FAILED
  FAILED
}

enum IntegrationRecordStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum ExternalRecordStatus {
  STAGED
  IMPORTED
  FAILED
}

model Patient {
  id              String   @id @default(uuid())
  hospitalPatientId String? @unique
  name            String
  gender          Gender   @default(UNKNOWN)
  birthDate       DateTime?
  phone           String?
  idCardNo        String?
  address         String?
  emergencyContactName  String?
  emergencyContactPhone String?

  responsibleDoctorId String?
  responsibleNurseId  String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  responsibleDoctor   User? @relation("PatientDoctor", fields: [responsibleDoctorId], references: [id])
  responsibleNurse    User? @relation("PatientNurse", fields: [responsibleNurseId], references: [id])

  diseaseProfiles DiseaseProfile[]
  vitalRecords    VitalRecord[]
  followUps       FollowUpRecord[]
  tasks           Task[]
  taskProcessingEvents TaskProcessingEvent[]

  riskAlerts     RiskAlert[]
  medicationRecords MedicationRecord[]
  medicationCheckIns MedicationCheckIn[]
  questionnaireResults QuestionnaireResult[]
  vitalMonitoringPlans VitalMonitoringPlan[]
  hospitalVisitReminders HospitalVisitReminder[]
  encounterRecords EncounterRecord[]
  medicalRecordSummaries MedicalRecordSummary[]
  examReportRecords ExamReportRecord[]
  hospitalMedicationOrders HospitalMedicationOrder[]

  @@index([responsibleDoctorId])
  @@index([responsibleNurseId])
  @@index([createdAt])
}

model DiseaseProfile {
  id             String      @id @default(uuid())
  patientId      String
  diseaseType    DiseaseType
  diagnosisDate  DateTime?
  diseaseStage   String?
  complications  String?
  comorbidities  String?
  riskLevel      RiskLevel   @default(LOW)
  dataSource     DataSource  @default(NURSE_INPUT)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient        Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([diseaseType])
  @@index([riskLevel])
  @@index([patientId, riskLevel])
}

model VitalRecord {
  id          String     @id @default(uuid())
  patientId   String
  type        String
  value       Float
  unit        String
  measuredAt  DateTime
  dataSource  DataSource @default(MINI_PROGRAM)
  isAbnormal  Boolean    @default(false)
  note        String?
  monitoringPlanId String?
  scheduledAt DateTime?

  createdAt   DateTime @default(now())

  patient     Patient @relation(fields: [patientId], references: [id])
  monitoringPlan VitalMonitoringPlan? @relation(fields: [monitoringPlanId], references: [id])

  @@index([patientId, measuredAt])
  @@index([patientId, type, measuredAt])
  @@index([monitoringPlanId, measuredAt])
  @@index([isAbnormal, measuredAt])
}

model FollowUpRecord {
  id              String   @id @default(uuid())
  patientId        String
  followUpType     String
  followUpTime     DateTime
  content          String?
  result           String?
  suggestion       String?
  nextFollowUpTime DateTime?
  operatorId       String?

  createdAt        DateTime @default(now())

  patient          Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, followUpTime])
  @@index([operatorId, followUpTime])
}

model Task {
  id          String     @id @default(uuid())
  patientId   String
  title       String
  type        String
  status      TaskStatus @default(PENDING)
  dueAt       DateTime?
  assigneeId  String?
  relatedAlertId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient     Patient @relation(fields: [patientId], references: [id])
  processingEvents TaskProcessingEvent[]

  @@index([patientId, status, dueAt])
  @@index([assigneeId, status, dueAt])
  @@index([relatedAlertId])
}

model TaskProcessingEvent {
  id                  String   @id @default(uuid())
  taskId              String
  patientId           String
  eventType           String
  title               String
  description         String?
  sourceType          String?
  sourceId            String?
  operatorId          String?
  electronicSignature String?
  createdAt           DateTime @default(now())

  task                Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  patient             Patient  @relation(fields: [patientId], references: [id])

  @@index([taskId, createdAt])
  @@index([patientId, createdAt])
  @@index([eventType, createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  operatorId  String?
  action      String
  targetType  String
  targetId    String?
  ipAddress   String?
  beforeData  Json?
  afterData   Json?
  createdAt   DateTime @default(now())

  @@index([operatorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
}

model RiskAlert {
  id                String      @id @default(uuid())
  patientId          String
  riskType           String
  riskLevel          RiskLevel   @default(MEDIUM)
  title              String
  description        String?
  triggerRule        String?
  sourceVitalRecordId String?
  status             AlertStatus @default(OPEN)

  handledBy          String?
  handledAt          DateTime?
  handlingNote       String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  patient            Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, status, createdAt])
  @@index([status, riskLevel, createdAt])
  @@index([sourceVitalRecordId])
}



model VitalMonitoringPlan {
  id             String     @id @default(uuid())
  patientId      String
  vitalType      String
  displayName    String
  unit           String
  frequencyUnit  String     @default("DAY")
  timesPerUnit   Int        @default(1)
  customMeasureTimes Json?
  customMeasureDays Json?
  reminderLeadMinutes Int   @default(180)
  checkInWindowBeforeMinutes Int @default(180)
  missedWindowAfterMinutes Int @default(180)
  sourcePreset   String?
  evidenceBasis  String?
  evidenceSource String?
  isActive       Boolean    @default(true)
  lastCheckInAt  DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient        Patient @relation(fields: [patientId], references: [id])
  vitalRecords   VitalRecord[]

  @@index([patientId, isActive])
  @@index([patientId, vitalType])
}

model MedicationRecord {
  id             String     @id @default(uuid())
  patientId      String
  medicationName String
  dosage         String

  // Backward-compatible display text generated from structured schedule fields.
  frequency      String
  frequencyUnit  String     @default("DAY")
  timesPerUnit   Int        @default(1)
  timingRelation String     @default("NONE")
  customDoseTimes Json?
  customDoseDays Json?
  reminderLeadMinutes Int   @default(180)
  checkInWindowBeforeMinutes Int @default(180)
  missedWindowAfterMinutes Int @default(180)

  instructions   String?
  startDate      DateTime?
  endDate        DateTime?
  dataSource     DataSource @default(NURSE_INPUT)
  isActive       Boolean    @default(true)
  lastCheckInAt  DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient        Patient @relation(fields: [patientId], references: [id])
  checkIns       MedicationCheckIn[]

  @@index([patientId, isActive])
  @@index([patientId, medicationName])
}

model MedicationCheckIn {
  id           String   @id @default(uuid())
  medicationId String
  patientId    String
  taken        Boolean  @default(true)
  checkedAt    DateTime
  scheduledAt  DateTime?
  note         String?

  createdAt    DateTime @default(now())

  medication   MedicationRecord @relation(fields: [medicationId], references: [id])
  patient      Patient @relation(fields: [patientId], references: [id])

  @@index([medicationId, scheduledAt])
  @@index([patientId, checkedAt])
}

model QuestionnaireResult {
  id                String     @id @default(uuid())
  patientId          String
  questionnaireType  String
  score              Int
  riskLevel          RiskLevel  @default(LOW)
  riskConclusion     String
  answers            Json?
  note               String?
  dataSource         DataSource @default(MINI_PROGRAM)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  patient            Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, createdAt])
  @@index([patientId, riskLevel, createdAt])
}


model User {
  id           String   @id @default(uuid())
  username     String   @unique
  displayName  String
  role         UserRole
  passwordHash String
  isActive     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientsAsDoctor Patient[] @relation("PatientDoctor")
  patientsAsNurse  Patient[] @relation("PatientNurse")

  @@index([role, isActive])
}

model PatientBindingRequest {
  id                String               @id @default(uuid())
  demoOpenId        String
  patientId         String
  hospitalPatientId String?
  phone             String
  idCardLast4       String?
  status            PatientBindingStatus @default(PENDING)
  rejectReason      String?
  reviewedBy        String?
  reviewedAt        DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([demoOpenId, status, createdAt])
  @@index([patientId, status])
  @@index([status, createdAt])
}

model PatientSession {
  id          String   @id @default(uuid())
  demoOpenId  String
  patientId   String
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?

  createdAt   DateTime @default(now())

  @@index([demoOpenId, patientId])
  @@index([patientId, expiresAt])
  @@index([expiresAt])
}


model HospitalVisitReminder {
  id                String                      @id @default(uuid())
  patientId         String
  sourceRiskAlertId String?
  reason            String
  note              String?
  status            HospitalVisitReminderStatus @default(ACTIVE)

  remindedBy        String?
  remindedAt        DateTime                    @default(now())

  revokedBy         String?
  revokedAt         DateTime?
  revokeReason      String?

  arrivedAt         DateTime?
  arrivalConfirmedBy String?

  noShowAt          DateTime?
  noShowConfirmedBy String?

  refusedAt         DateTime?
  refusalConfirmedBy String?

  outcomeNote       String?

  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  patient           Patient                     @relation(fields: [patientId], references: [id])

  @@index([patientId, status, remindedAt])
  @@index([status, remindedAt])
  @@index([sourceRiskAlertId])
}

model DiseaseRuleTemplate {
  id              String      @id @default(uuid())
  diseaseType     DiseaseType
  templateName    String
  description     String?
  managementGoal  String?
  riskBasis       String?
  version         String      @default("v1")
  isActive        Boolean     @default(true)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  vitalThresholdRules VitalThresholdRule[]
  followUpPolicies    FollowUpPolicy[]
  questionnaireTemplates QuestionnaireTemplate[]

  @@unique([diseaseType, version])
  @@index([diseaseType, isActive])
}

model VitalThresholdRule {
  id                String      @id @default(uuid())
  templateId         String
  vitalType          String
  displayName        String
  unit               String
  operator           String
  thresholdValue     Float
  thresholdValueMax  Float?
  riskLevel          RiskLevel
  alertTitle         String
  alertDescription   String?
  followUpAction     String?
  sortOrder          Int         @default(100)
  isActive           Boolean     @default(true)

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  template            DiseaseRuleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, isActive])
  @@index([vitalType, isActive])
  @@index([riskLevel, isActive])
}

model FollowUpPolicy {
  id                    String      @id @default(uuid())
  templateId             String
  riskLevel              RiskLevel
  followUpType           String
  dueWithinHours         Int
  frequencyDescription   String
  taskTitle              String
  instruction            String?
  isActive               Boolean     @default(true)

  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  template                DiseaseRuleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, riskLevel, isActive])
  @@index([riskLevel, isActive])
}

model QuestionnaireTemplate {
  id                  String      @id @default(uuid())
  templateId           String
  questionnaireType    String
  title                String
  description          String?
  scoringRule          Json?
  riskBands            Json?
  isActive             Boolean     @default(true)

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  template              DiseaseRuleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, isActive])
  @@index([questionnaireType, isActive])
}

model IntegrationSource {
  id          String                @id @default(uuid())
  code        String                @unique
  name        String
  systemType  IntegrationSystemType
  baseUrl     String?
  description String?
  isEnabled   Boolean               @default(true)

  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  syncBatches  IntegrationSyncBatch[]
  syncRecords  IntegrationSyncRecord[]
  fieldMappings IntegrationFieldMapping[]

  @@index([systemType, isEnabled])
}

model IntegrationSyncBatch {
  id           String                 @id @default(uuid())
  sourceId     String
  batchType    String
  status       IntegrationSyncStatus  @default(PENDING)
  startedAt    DateTime               @default(now())
  finishedAt   DateTime?
  totalCount   Int                    @default(0)
  successCount Int                    @default(0)
  failedCount  Int                    @default(0)
  operatorId   String?
  message      String?

  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  source        IntegrationSource      @relation(fields: [sourceId], references: [id])
  records       IntegrationSyncRecord[]

  @@index([sourceId, status, startedAt])
  @@index([batchType, status, startedAt])
}

model IntegrationSyncRecord {
  id                 String                  @id @default(uuid())
  sourceId           String
  batchId            String
  externalRecordType String
  externalRecordId   String
  localTargetType    String?
  localTargetId      String?
  status             IntegrationRecordStatus
  errorMessage        String?
  rawData             Json?
  normalizedData      Json?

  createdAt           DateTime                @default(now())

  source              IntegrationSource       @relation(fields: [sourceId], references: [id])
  batch               IntegrationSyncBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([sourceId, externalRecordType, externalRecordId])
  @@index([batchId, status])
  @@index([localTargetType, localTargetId])
}

model IntegrationFieldMapping {
  id            String             @id @default(uuid())
  sourceId      String
  targetModel   String
  externalField String
  localField    String
  displayName   String?
  transformRule String?
  defaultValue  String?
  isRequired    Boolean            @default(false)
  isActive      Boolean            @default(true)

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  source        IntegrationSource  @relation(fields: [sourceId], references: [id])

  @@unique([sourceId, targetModel, externalField])
  @@index([sourceId, targetModel, isActive])
}

model ExternalPatientRecord {
  id                String               @id @default(uuid())
  sourceId          String
  externalPatientId String
  hospitalPatientId String
  name              String
  gender            Gender               @default(UNKNOWN)
  birthDate         DateTime?
  phone             String?
  idCardNo          String?
  address           String?
  rawData           Json?
  importStatus      ExternalRecordStatus @default(STAGED)
  localPatientId     String?
  errorMessage       String?

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([sourceId, externalPatientId])
  @@index([hospitalPatientId])
  @@index([sourceId, importStatus, createdAt])
  @@index([localPatientId])
}

model ExternalDiagnosisRecord {
  id                  String               @id @default(uuid())
  sourceId            String
  externalDiagnosisId String
  hospitalPatientId   String
  diseaseType         DiseaseType
  diagnosisDate       DateTime?
  diseaseStage        String?
  complications       String?
  comorbidities       String?
  riskLevel           RiskLevel            @default(LOW)
  rawData             Json?
  importStatus        ExternalRecordStatus @default(STAGED)
  localDiseaseProfileId String?
  errorMessage        String?

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([sourceId, externalDiagnosisId])
  @@index([hospitalPatientId])
  @@index([sourceId, importStatus, createdAt])
  @@index([localDiseaseProfileId])
}

model ExternalLabResultRecord {
  id                  String               @id @default(uuid())
  sourceId            String
  externalLabResultId String
  hospitalPatientId   String
  labItemCode         String
  labItemName         String
  vitalType           String
  value               Float
  unit                String
  measuredAt          DateTime
  rawData             Json?
  importStatus        ExternalRecordStatus @default(STAGED)
  localVitalRecordId   String?
  errorMessage        String?

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([sourceId, externalLabResultId])
  @@index([hospitalPatientId, measuredAt])
  @@index([sourceId, importStatus, createdAt])
  @@index([localVitalRecordId])
}

model ExternalPrescriptionRecord {
  id                      String               @id @default(uuid())
  sourceId                String
  externalPrescriptionId  String
  hospitalPatientId       String
  medicationName          String
  dosage                  String
  frequency               String
  instructions            String?
  startDate               DateTime?
  endDate                 DateTime?
  rawData                 Json?
  importStatus            ExternalRecordStatus @default(STAGED)
  localMedicationRecordId  String?
  errorMessage            String?

  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@unique([sourceId, externalPrescriptionId])
  @@index([hospitalPatientId])
  @@index([sourceId, importStatus, createdAt])
  @@index([localMedicationRecordId])
}

model EncounterRecord {
  id                String   @id @default(uuid())
  patientId         String
  hospitalPatientId String?
  externalVisitId   String?
  visitType         EncounterType
  departmentName    String?
  doctorName        String?
  visitTime         DateTime
  chiefComplaint    String?
  diagnosisSummary  String?
  treatmentSummary  String?
  dataSource        DataSource @default(HIS)
  sourceSystem      String?
  rawData           Json?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  patient           Patient @relation(fields: [patientId], references: [id])
  hospitalMedicationOrders HospitalMedicationOrder[]

  @@index([patientId, visitTime])
  @@index([visitType, visitTime])
  @@index([externalVisitId])
}

model MedicalRecordSummary {
  id              String   @id @default(uuid())
  patientId       String
  externalRecordId String?
  recordType      MedicalRecordType
  recordTime      DateTime
  departmentName  String?
  title           String
  summary         String?
  diagnosisText   String?
  treatmentPlan   String?
  doctorAdvice    String?
  dataSource      DataSource @default(EMR)
  sourceSystem    String?
  rawData         Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patient         Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, recordTime])
  @@index([recordType, recordTime])
  @@index([externalRecordId])
}

model ExamReportRecord {
  id              String   @id @default(uuid())
  patientId       String
  externalExamId  String?
  examType        String
  examName        String
  examTime        DateTime
  departmentName  String?
  finding         String?
  conclusion      String?
  reportUrl       String?
  dataSource      DataSource @default(HIS)
  sourceSystem    String?
  rawData         Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patient         Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, examTime])
  @@index([examType, examTime])
  @@index([externalExamId])
}

model HospitalMedicationOrder {
  id                    String   @id @default(uuid())
  patientId             String
  externalOrderId       String?
  encounterRecordId     String?
  medicationName        String
  dosage                String
  frequency             String
  route                 String?
  duration              String?
  prescribedBy          String?
  prescribedAt          DateTime
  dataSource            DataSource @default(HIS)
  sourceSystem          String?
  rawData               Json?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  patient               Patient @relation(fields: [patientId], references: [id])
  encounterRecord       EncounterRecord? @relation(fields: [encounterRecordId], references: [id])

  @@index([patientId, prescribedAt])
  @@index([encounterRecordId])
  @@index([externalOrderId])
}





