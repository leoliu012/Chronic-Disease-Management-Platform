<view class="container">
  <view class="card hero-card">
    <view class="card-title">加入慢病管理 · 患者绑定</view>
    <view class="card-subtitle">
      请输入您在医院的院内号 / 手机号 / 身份证后四位，搜索本人院内信息。
      确认身份后签署知情同意书并提交绑定申请，护士审核通过即可查看本人慢病档案。
    </view>
  </view>

  <!-- 当前绑定状态 -->
  <view class="card status-card">
    <view class="item-title">当前绑定状态</view>
    <view class="status-row">
      <text class="status-pill status-open" wx:if="{{bindingStatus === 'PENDING'}}">待护士审核（自动刷新中…）</text>
      <text class="status-pill status-done" wx:elif="{{bindingStatus === 'APPROVED'}}">已通过</text>
      <text class="status-pill status-muted" wx:elif="{{bindingStatus === 'REJECTED'}}">已拒绝</text>
      <text class="status-pill status-muted" wx:else>未绑定</text>
    </view>
    <view class="item-desc" wx:if="{{message}}">{{message}}</view>
    <view class="item-desc">小程序身份：{{demoOpenId}}</view>
    <view wx:if="{{patient}}" class="patient-mini-card">
      <view class="item-title">{{patient.name || '已匹配患者'}}</view>
      <view class="item-desc">院内号：{{patient.hospitalPatientId || '-'}}</view>
    </view>
    <view wx:if="{{bound}}" class="item-desc">
      您当前已绑定上述档案。若要切换 / 绑定其他身份，请点「清除并切换身份」，再到下方重新搜索。
    </view>
    <button wx:if="{{bound}}" class="primary-btn" bindtap="goHome">进入慢病管理首页</button>
    <view class="btn-row">
      <button class="secondary-btn" loading="{{loading}}" bindtap="checkBindingStatus">刷新状态</button>
      <button class="danger-btn" bindtap="resetBinding">清除并切换身份</button>
    </view>
  </view>

  <!-- 第一步：搜索院内信息 -->
  <view class="card">
    <view class="item-title step-title">第一步 · 搜索院内信息</view>

    <view class="form-item">
      <text class="form-label">后端 API 地址</text>
      <input class="input" value="{{apiBaseUrl}}" placeholder="例如 http://127.0.0.1:3000" bindinput="onApiBaseUrlInput" />
      <view class="muted">开发工具可用 127.0.0.1；真机调试请改为电脑局域网 IP。</view>
    </view>

    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="input" value="{{phone}}" type="number" maxlength="11" placeholder="医院档案中的本人手机号" bindinput="onPhoneInput" />
    </view>

    <view class="form-item">
      <text class="form-label">院内号 / 门诊号</text>
      <input class="input" value="{{hospitalPatientId}}" placeholder="例如 MZ20260519001" bindinput="onHospitalPatientIdInput" />
    </view>

    <view class="form-item">
      <text class="form-label">身份证后四位</text>
      <input class="input" value="{{idCardLast4}}" type="number" maxlength="4" placeholder="用于辅助核验身份" bindinput="onIdCardLast4Input" />
    </view>

    <button class="primary-btn" loading="{{searching}}" bindtap="searchIdentity">搜索我的院内信息</button>
    <view class="muted">系统会按「邀约库 → 已有档案 → 院内系统」顺序为您匹配。</view>
  </view>

  <!-- 第二步：搜索结果 -->
  <block wx:if="{{lookupDone}}">
    <!-- 匹配成功 -->
    <view wx:if="{{matchType === 'CHRONIC_LEAD' || matchType === 'EXISTING_PATIENT'}}" class="card result-card">
      <view class="item-title step-title">第二步 · 确认这是我的信息</view>
      <view class="match-pill">{{matchTypeLabel}}</view>

      <view wx:if="{{snapshot}}" class="snapshot-box">
        <view class="snapshot-row">
          <text class="snapshot-label">姓名</text>
          <text class="snapshot-value">{{snapshot.name || '（未提供）'}}</text>
        </view>
        <view class="snapshot-row">
          <text class="snapshot-label">院内号</text>
          <text class="snapshot-value">{{snapshot.hospitalPatientId || '—'}}</text>
        </view>
        <view class="snapshot-row">
          <text class="snapshot-label">手机号</text>
          <text class="snapshot-value">{{snapshot.phone || '—'}}</text>
        </view>
        <view class="snapshot-row">
          <text class="snapshot-label">身份证</text>
          <text class="snapshot-value">{{snapshot.idCardNo || '—'}}</text>
        </view>
        <view class="snapshot-row">
          <text class="snapshot-label">疑似病种</text>
          <text class="snapshot-value">{{snapshotDiseaseLabel}}</text>
        </view>
        <view class="snapshot-row" wx:if="{{snapshot.riskHint}}">
          <text class="snapshot-label">风险提示</text>
          <text class="snapshot-value risk-{{snapshot.riskHint}}">{{snapshotRiskLabel}}</text>
        </view>
        <view wx:if="{{snapshot.diagnosisIcd}}" class="snapshot-row">
          <text class="snapshot-label">临床证据</text>
          <text class="snapshot-value">{{snapshot.diagnosisIcd}} · {{snapshot.diagnosisText || ''}}</text>
        </view>
        <view wx:if="{{snapshot.evidenceSummary}}" class="snapshot-row">
          <text class="snapshot-label">证据摘要</text>
          <text class="snapshot-value">{{snapshot.evidenceSummary}}</text>
        </view>
        <view class="snapshot-row">
          <text class="snapshot-label">数据来源</text>
          <text class="snapshot-value">{{snapshotSourceLabel}}</text>
        </view>
      </view>

      <view wx:if="{{alreadySigned}}" class="muted">该线索此前已建档，确认后将直接为您提交绑定申请。</view>

      <view class="btn-row">
        <button class="secondary-btn" bindtap="research">重新搜索</button>
        <button class="primary-btn" bindtap="goConsentSign">确认是我，去签署同意书</button>
      </view>
    </view>

    <!-- 仅查到 HIS 暂存信息 -->
    <view wx:elif="{{matchType === 'HIS_PATIENT'}}" class="card result-card">
      <view class="item-title">查到院内系统暂存信息</view>
      <view class="item-desc">
        系统中暂未建立您的慢病档案，仅在院内系统查到基础信息。
        请联系门诊护士在院内系统核验后协助为您加入慢病管理。
      </view>
      <button class="secondary-btn" bindtap="research">重新搜索</button>
    </view>

    <!-- 未匹配 -->
    <view wx:else class="card result-card">
      <view class="item-title">未匹配到您的院内信息</view>
      <view class="item-desc" wx:if="{{matchReason === 'NEED_INPUT'}}">请至少填写一项识别信息后再搜索。</view>
      <view class="item-desc" wx:else>
        未查到与该信息匹配的邀约线索或患者档案。请核对手机号、院内号或身份证后四位；
        如确有就诊记录，请联系医院协助人工核验。
      </view>
      <button class="secondary-btn" bindtap="research">重新搜索</button>
    </view>
  </block>

  <view class="card audit-card">
    <view class="item-title">流程说明</view>
    <view class="item-desc">
      搜索院内信息 → 确认身份 → 签署知情同意书 → 提交绑定申请 → 护士审核。
      若匹配到医院邀约库，提交绑定申请时会同步完成签约建档与入组随访计划生成。
    </view>
  </view>

  <view class="safe-bottom" />
</view>
