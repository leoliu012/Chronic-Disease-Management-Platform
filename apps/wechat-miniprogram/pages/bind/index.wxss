.hero-card {
  background: linear-gradient(135deg, #0b63ce, #18a0fb);
}

.hero-card .card-title,
.hero-card .card-subtitle {
  color: #ffffff;
}

.status-card {
  border-left: 8rpx solid #0b63ce;
}

.status-row {
  margin: 12rpx 0;
}

.patient-mini-card {
  margin-top: 18rpx;
  border: 1rpx solid #d8e6f6;
  background: #f8fbff;
  border-radius: 18rpx;
  padding: 18rpx;
}

.divider {
  text-align: center;
  color: #90a0b4;
  font-size: 24rpx;
  margin: 10rpx 0 24rpx;
}

.audit-card {
  background: #fbfdff;
}
