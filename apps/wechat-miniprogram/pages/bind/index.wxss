.hero-card {
  background: linear-gradient(135deg, #0b63ce, #18a0fb);
}

.hero-card .card-title,
.hero-card .card-subtitle {
  color: #ffffff;
}

.status-card {
  border-left: 8rpx solid #0b63ce;
}

.status-row {
  margin: 12rpx 0;
}

.patient-mini-card {
  margin-top: 18rpx;
  border: 1rpx solid #d8e6f6;
  background: #f8fbff;
  border-radius: 18rpx;
  padding: 18rpx;
}

.official-account-box {
  margin-top: 18rpx;
  border: 1rpx solid #d8e6f6;
  background: #f8fbff;
  border-radius: 18rpx;
  padding: 18rpx;
}

.link-box {
  margin-top: 16rpx;
  padding: 16rpx;
  border: 1rpx dashed #b8c7d9;
  border-radius: 14rpx;
  background: #ffffff;
}

.link-text {
  display: block;
  margin: 10rpx 0 14rpx;
  color: #4a5b70;
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}

.compact-btn {
  margin-top: 8rpx;
}

.step-title {
  color: #0b63ce;
}

.result-card {
  border-left: 8rpx solid #18a0fb;
}

.match-pill {
  display: inline-block;
  margin: 8rpx 0 16rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #0b63ce;
  background: #e8f2ff;
}

.snapshot-box {
  border: 1rpx solid #e1e8f0;
  border-radius: 16rpx;
  padding: 12rpx 18rpx;
  margin-bottom: 16rpx;
  background: #fbfdff;
}

.snapshot-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eef2f6;
  font-size: 26rpx;
}

.snapshot-row:last-child {
  border-bottom: none;
}

.snapshot-label {
  color: #90a0b4;
  flex: 0 0 150rpx;
}

.snapshot-value {
  color: #1f2d3d;
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
  word-break: break-all;
}

.risk-HIGH,
.risk-VERY_HIGH {
  color: #d83b01;
  font-weight: 600;
}

.risk-MEDIUM {
  color: #b7791f;
}

.audit-card {
  background: #fbfdff;
}
