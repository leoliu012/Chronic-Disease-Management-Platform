/**
 * pages/consent-sign/index.wxss — 知情同意书确认页样式
 * 复用 app.wxss 提供的 .card / .input / .primary-btn / .form-item / .muted 等基础类，
 * 这里只补本页面专属样式。
 */

.consent-sign-page .hero-card {
  background: linear-gradient(135deg, #0b63ce, #18a0fb);
}

.consent-sign-page .hero-card .card-title,
.consent-sign-page .hero-card .card-subtitle {
  color: #ffffff;
}

/* 患者快照 */
.lead-snapshot {
  border-left: 8rpx solid #0b63ce;
}

.match-pill {
  display: inline-block;
  margin: 8rpx 0 14rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #0b63ce;
  background: #e8f2ff;
}

.snapshot-row {
  display: flex;
  padding: 10rpx 0;
  border-bottom: 1rpx dashed #e1e9f3;
  font-size: 26rpx;
}

.snapshot-row:last-child {
  border-bottom: none;
}

.snapshot-row.evidence-row {
  flex-direction: column;
  gap: 6rpx;
}

.snapshot-label {
  flex: 0 0 160rpx;
  color: #62728a;
}

.snapshot-value {
  flex: 1;
  color: #172033;
  font-weight: 600;
  word-break: break-all;
}

.snapshot-value.risk-VERY_HIGH {
  color: #be123c;
}

.snapshot-value.risk-HIGH {
  color: #c2410c;
}

.snapshot-value.risk-MEDIUM {
  color: #b45309;
}

.snapshot-value.risk-LOW {
  color: #047857;
}

/* 知情同意协议 */
.consent-card {
  background: #fbfdff;
}

.consent-version {
  margin-bottom: 24rpx;
  font-size: 24rpx;
}

.consent-section {
  margin-bottom: 20rpx;
}

.consent-heading {
  font-size: 28rpx;
  font-weight: 700;
  color: #123763;
  margin-bottom: 8rpx;
}

.consent-paragraph {
  font-size: 26rpx;
  color: #37506d;
  line-height: 1.7;
  text-indent: 2em;
}

.consent-checkbox {
  display: flex;
  align-items: flex-start;
  margin-top: 24rpx;
  padding: 22rpx;
  background: #eaf3ff;
  border-radius: 16rpx;
}

.checkbox-box {
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #0b63ce;
  border-radius: 8rpx;
  background: #ffffff;
  margin-right: 18rpx;
  margin-top: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.checkbox-box.checked {
  background: #0b63ce;
}

.checkbox-label {
  flex: 1;
  font-size: 26rpx;
  color: #172033;
  line-height: 1.6;
}

.checkbox-label .strong {
  color: #0b63ce;
  font-weight: 700;
}

/* 提交按钮 */
.sign-action-card {
  background: #ffffff;
}

.sign-btn {
  width: 100%;
  height: 96rpx;
  font-size: 30rpx;
}

.sign-disclaimer {
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.5;
}

.error-banner {
  background: #fff1f2;
  color: #be123c;
  font-size: 26rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  margin-bottom: 18rpx;
}

/* 提交成功 */
.success-card {
  border-left: 8rpx solid #047857;
  background: #f0fdf4;
}

.success-card .item-title {
  color: #047857;
  font-size: 32rpx;
}

.result-message {
  white-space: pre-wrap;
  line-height: 1.6;
}

.status-line {
  margin: 16rpx 0;
}

.patient-mini-card {
  margin-top: 18rpx;
  border: 1rpx solid #c7e9d2;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 18rpx;
}

.recovering-banner {
  background: #fff7e6;
  border-color: #ffd591;
  color: #ad6800;
}

.tap-btn {
  text-align: center;
  box-sizing: border-box;
  user-select: none;
}

.tap-btn-hover {
  opacity: 0.78;
  transform: scale(0.98);
}
