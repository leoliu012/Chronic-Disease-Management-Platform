.hero-card {
  background: linear-gradient(135deg, #0b63ce, #18a0fb);
}

.hero-card .card-title,
.hero-card .card-subtitle {
  color: #ffffff;
}

.bind-btn,
.submit-btn {
  margin-top: 28rpx;
}

.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin: 10rpx 0 28rpx;
}

.quick-btn {
  margin: 0;
  padding: 0 22rpx;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 999rpx;
  background: #eef6ff;
  color: #0b63ce;
  font-size: 24rpx;
}

.alert-box {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
}

.task-box {
  background: #eff6ff;
  border-color: #bfdbfe;
}

.ok-box {
  background: #ecfdf5;
  border-color: #bbf7d0;
}

.plan-card {
  padding-bottom: 8rpx;
}

.plan-item {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #e6edf5;
}

.plan-item:last-child {
  border-bottom: 0;
}

.plan-main {
  flex: 1;
}

.plan-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: flex-end;
}

.mini-btn {
  margin: 0;
  padding: 0 18rpx;
  min-width: 120rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  border-radius: 999rpx;
}

.danger-btn {
  background: #fff1f2;
  color: #be123c;
}
