--- chronic_platform_snapshot/scripts/apply_audit_ops_v8.py	1970-01-01 00:00:00.000000000 +0000
+++ chronic_platform_v8_work/scripts/apply_audit_ops_v8.py	2026-06-09 14:44:48.187961898 +0000
@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+# audit_ops_v8_medical_audit_and_operations_center
+# Self-contained idempotent installer generated from a validated source snapshot.
+from __future__ import annotations
+import base64
+import datetime as dt
+import json
+from pathlib import Path
+import shutil
+import sys
+import zlib
+
+PAYLOAD = ''
+
+def main() -> int:
+    root = Path.cwd()
+    if not (root / 'apps/api/src/app.module.ts').exists():
+        print('[FAIL] run from Chronic-Disease-Management-Platform repository root', file=sys.stderr)
+        return 1
+
+    files: dict[str, str] = json.loads(zlib.decompress(base64.b64decode(PAYLOAD)).decode('utf-8'))
+    stamp = dt.datetime.now().strftime('%Y%m%d-%H%M%S')
+    backup_root = root / '.patch-backups' / f'audit-ops-v8-{stamp}'
+    changed = 0
+    skipped = 0
+
+    for relative, content in files.items():
+        target = root / relative
+        current = target.read_text(encoding='utf-8') if target.exists() else None
+        if current == content:
+            print(f'[skip] {relative}')
+            skipped += 1
+            continue
+
+        if target.exists():
+            backup = backup_root / relative
+            backup.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copy2(target, backup)
+
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_text(content, encoding='utf-8')
+        print(f'[ok] installed {relative}')
+        changed += 1
+
+    if changed:
+        print(f'[ok] backup directory: {backup_root}')
+    else:
+        print('[ok] no file changes required; patch already applied')
+    print(f'[summary] changed={changed} skipped={skipped}')
+    print('[next] node scripts/assert-audit-ops-v8.js')
+    print('[next] cd apps/api && npm run build')
+    print('[next] cd ../web && npm run build')
+    return 0
+
+if __name__ == '__main__':
+    raise SystemExit(main())
