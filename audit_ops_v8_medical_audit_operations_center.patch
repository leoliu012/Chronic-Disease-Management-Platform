diff -ruN chronic_platform_snapshot/apps/web/src/pages/AdminOpsPage.tsx chronic_platform_v8_work/apps/web/src/pages/AdminOpsPage.tsx
--- chronic_platform_snapshot/apps/web/src/pages/AdminOpsPage.tsx	1970-01-01 00:00:00.000000000 +0000
