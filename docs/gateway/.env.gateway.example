# ----------------------------------------------------------------------------
# 医疗数据接入网关 (Gateway) — 环境变量样例
# ----------------------------------------------------------------------------
# 把需要的变量拷到 apps/api/.env 或部署平台的环境变量中.
# 三个通道都遵循 fail-closed: 变量不设 → 通道关闭.
# ----------------------------------------------------------------------------

# ---- 入站 REST 接口认证 ----
# 新机制 (gateway-production-hardening): 每个外部系统一把 GatewayApiKey,
# 通过 POST /gateway/admin/api-keys 签发, header 形如 X-Gateway-Api-Key: gwk_<prefix>_<secret>
# 一旦签发了至少一把, 该来源的请求 必须 携带 gwk_ 前缀的 key.
#
# 旧机制 (兼容): GATEWAY_API_KEY 仍可作为 dev/单机演示的 fallback.
# 生产环境 (NODE_ENV=production) 会拒绝这条 fallback, 强制走新机制.
GATEWAY_API_KEY=dev_gateway_key_change_in_prod

# ---- 全局 IP 白名单 (所有网关接口共享) ----
# 逗号分隔的 CIDR, 留空 = 不限制 (依赖每把 key 自己的 ipAllowlist).
# 例: GATEWAY_GLOBAL_IP_ALLOWLIST=10.0.0.0/8,192.168.0.0/16,::1/128
GATEWAY_GLOBAL_IP_ALLOWLIST=

# ---- HL7 v2 MLLP TCP 监听 ----
GATEWAY_HL7_ENABLED=false
GATEWAY_HL7_HOST=0.0.0.0
GATEWAY_HL7_PORT=2575

# ---- 中间表 / 前置机 轮询 ----
GATEWAY_INTERMEDIATE_POLLER_ENABLED=false
GATEWAY_INTERMEDIATE_POLLER_INTERVAL_MS=300000

# 中间表适配器选择 — mock (默认, 演示) / sqlserver / oracle
# 切换到 sqlserver 或 oracle 前请先 `npm install mssql` 或 `npm install oracledb`
GATEWAY_INTERMEDIATE_ADAPTER=mock

# SQL Server 前置机 (适配器=sqlserver 时生效)
GATEWAY_INTERMEDIATE_MSSQL_HOST=10.1.0.50
GATEWAY_INTERMEDIATE_MSSQL_PORT=1433
GATEWAY_INTERMEDIATE_MSSQL_USER=chronic_readonly
GATEWAY_INTERMEDIATE_MSSQL_PASSWORD=
GATEWAY_INTERMEDIATE_MSSQL_DATABASE=HIS_BRIDGE
GATEWAY_INTERMEDIATE_MSSQL_ENCRYPT=true
GATEWAY_INTERMEDIATE_MSSQL_TRUST_CERT=false
# 默认表名 — 大多数情况无需改:
GATEWAY_INTERMEDIATE_MSSQL_PATIENT_TABLE=v_chronic_patient
GATEWAY_INTERMEDIATE_MSSQL_DIAGNOSIS_TABLE=v_chronic_diagnosis
GATEWAY_INTERMEDIATE_MSSQL_LAB_TABLE=v_chronic_lab_result
GATEWAY_INTERMEDIATE_MSSQL_PRESCRIPTION_TABLE=v_chronic_prescription
GATEWAY_INTERMEDIATE_MSSQL_DISCHARGE_TABLE=v_chronic_discharge

# Oracle 前置机 (适配器=oracle 时生效)
GATEWAY_INTERMEDIATE_ORACLE_USER=chronic_readonly
GATEWAY_INTERMEDIATE_ORACLE_PASSWORD=
GATEWAY_INTERMEDIATE_ORACLE_CONNECT_STRING=10.1.0.51:1521/HIS_BRIDGE
GATEWAY_INTERMEDIATE_ORACLE_PATIENT_TABLE=V_CHRONIC_PATIENT
GATEWAY_INTERMEDIATE_ORACLE_DIAGNOSIS_TABLE=V_CHRONIC_DIAGNOSIS
GATEWAY_INTERMEDIATE_ORACLE_LAB_TABLE=V_CHRONIC_LAB_RESULT
GATEWAY_INTERMEDIATE_ORACLE_PRESCRIPTION_TABLE=V_CHRONIC_PRESCRIPTION
GATEWAY_INTERMEDIATE_ORACLE_DISCHARGE_TABLE=V_CHRONIC_DISCHARGE

# ---- Promotion retry worker (gateway-production-hardening) ----
# Promote 失败 record 的指数退避重试.
# 默认: 60s 起步, 翻倍至 1h 封顶, 共 6 次后宣告耗尽并发告警.
GATEWAY_PROMOTION_WORKER_ENABLED=true
GATEWAY_PROMOTION_WORKER_INTERVAL_MS=60000
GATEWAY_PROMOTION_WORKER_MAX_ATTEMPTS=6
GATEWAY_PROMOTION_WORKER_BATCH=50

# ---- 告警 webhook (gateway-production-hardening) ----
# RETRY_EXHAUSTED / ADAPTER_DOWN / HIGH_FAILURE_RATE 触发 POST 到此 URL.
# Payload 是通用 JSON, 由你的钉钉/企微/Slack 转发服务适配.
# 留空 = 仅写日志, 不外发.
GATEWAY_ALERT_WEBHOOK_URL=
